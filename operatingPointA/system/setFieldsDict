FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pre-fill the injector tube with the injection temperature.

defaultFieldValues
(
    volScalarFieldValue T 297
);

regions
(
    boxToCell
    {
        box (0 0 0) (0.051 0.0012 0.01);
        field T;
        value 137;
    }
);


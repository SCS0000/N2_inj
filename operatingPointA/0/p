FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Operating point A: chamber pressure p_ch = 39.8 bar
dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 3.98e6;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 3.98e6;
    }

    injectorWall
    {
        type            zeroGradient;
    }

    chamberWall
    {
        type            zeroGradient;
    }

    wedge
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}


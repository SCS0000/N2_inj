FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// epsilon_in = Cmu^0.75 * k^1.5 / l, l = 0.07*d = 1.54e-4 m -> 38.6 m^2/s^3
dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 38.6;
    }

    outlet
    {
        type            zeroGradient;
    }

    injectorWall
    {
        type            epsilonWallFunction;
        value           uniform 0;
    }

    chamberWall
    {
        type            epsilonWallFunction;
        value           uniform 0;
    }

    wedge
    {
        type            wedge;
    }

    axis
    {
        type            empty;
    }
}

